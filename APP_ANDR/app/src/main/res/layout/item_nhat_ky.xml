<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="#FAFAFA">

        <!-- Thời gian (Tự động chốt, không cho sửa) -->
        <TextView
            android:id="@+id/tvThoiGianNhatKy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09/09/2026 - 08:30 AM"
            android:textColor="#2E7D32"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Biểu tượng "Đã khóa bảo mật bằng Hash" -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/ic_secure"
                app:tint="#4CAF50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Đã băm an toàn"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Thông tin chi tiết -->
        <TextView
            android:id="@+id/tvChiTietVatTu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvThoiGianNhatKy"
            android:layout_marginTop="8dp"
            android:text="Tên: Cám ngô\nLiều lượng: 5 kg\nTần suất: 2 lần/ngày"
            android:textColor="#333333"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"/>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
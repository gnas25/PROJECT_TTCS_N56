<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical"
    android:fitsSystemWindows="true"> <!-- THÊM DÒNG NÀY -->

    <!-- Các đoạn code bên dưới giữ nguyên -->

    <!-- Thanh tiêu đề có nút Quay lại -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#2E7D32"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="NHẬT KÝ LÔ HÀNG"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Khu vực hiển thị Mã QR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#FFFFFF">

        <ImageView
            android:id="@+id/imgQRCode"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:background="#E0E0E0"
            android:contentDescription="Mã QR" />
        <!-- Màu nền xám tạm thời để bạn dễ hình dung vị trí mã QR sẽ xuất hiện -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Quét mã để kiểm tra nguồn gốc &amp; bảo mật"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="italic" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#E0E0E0" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="LỊCH SỬ CHĂM SÓC"
        android:textColor="#1B5E20"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Danh sách nhật ký (Chiếm toàn bộ khoảng trống còn lại) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDanhSachNhatKy"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="8dp"
        android:paddingBottom="16dp" />

</LinearLayout>
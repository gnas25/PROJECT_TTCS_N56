<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Tiêu đề Popup -->
    <TextView
        android:id="@+id/tvTitlePopup3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="CẬP NHẬT: NÔNG SẢN"
        android:textColor="#2E7D32"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- 1. Tên thức ăn -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="#2E7D32"
        app:hintTextColor="#2E7D32">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtTenThucAn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên thức ăn"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 2. Liều lượng -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxStrokeColor="#2E7D32"
        app:hintTextColor="#2E7D32">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtLieuLuong"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Liều lượng (VD: 5 kg)"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- 3. Tần suất cho ăn -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:boxStrokeColor="#2E7D32"
        app:hintTextColor="#2E7D32">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtTanSuat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tần suất cho ăn (VD: 2 lần/ngày)"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nút LƯU -->
    <Button
        android:id="@+id/btnLuuNhatKy"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:backgroundTint="#2E7D32"
        android:text="LƯU DỮ LIỆU"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="10dp" />

</LinearLayout>